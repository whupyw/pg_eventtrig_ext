DROP TABLE system_startups;
DROP EVENT TRIGGER on_startup_trigger;
DROP FUNCTION on_startup_proc();

CREATE TABLE system_startups (
    id SERIAL PRIMARY KEY,
    startup_time TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

CREATE FUNCTION on_startup_proc() RETURNS EVENT_TRIGGER AS $$
DECLARE
BEGIN
    INSERT INTO system_startups (startup_time)
    VALUES (CURRENT_TIMESTAMP);
    RAISE NOTICE 'Hi!!!!!!!!';
    RAISE NOTICE 'System startup at %', CURRENT_TIMESTAMP;
END;
$$ LANGUAGE plpgsql;

CREATE EVENT TRIGGER on_startup_trigger ON startup EXECUTE PROCEDURE on_startup_proc();

ALTER EVENT TRIGGER on_startup_trigger ENABLE ALWAYS;

SELECT * FROM system_startups;

-- 重启 PostgreSQL 服务以触发 startup 事件。
-- 关闭数据库：
/usr/local/pgsql/bin/pg_ctl stop -D /usr/local/pgsql/data

-- 启用数据库：
/usr/local/pgsql/bin/pg_ctl -D /usr/local/pgsql/data -l logfile start
/usr/local/pgsql/bin/psql -U cjw -d postgres

SELECT * FROM system_startups;

-- 再次重启 PostgreSQL 服务
-- 关闭数据库：
/usr/local/pgsql/bin/pg_ctl stop -D /usr/local/pgsql/data

-- 启用数据库：
/usr/local/pgsql/bin/pg_ctl -D /usr/local/pgsql/data -l logfile start
/usr/local/pgsql/bin/psql -U cjw -d postgres

SELECT * FROM system_startups;


