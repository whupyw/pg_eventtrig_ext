SELECT * FROM pg_event_trigger;

-- Cleanup
DROP TABLE user_logouts;
DROP EVENT TRIGGER on_logout_trigger;
DROP FUNCTION on_logout_proc();
\c

-- 创建用于记录用户登出信息的表
CREATE TABLE user_logouts (
    id SERIAL PRIMARY KEY,
    who TEXT NOT NULL,
    logout_time TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- 创建事件触发器函数-- 插入用户登出信息到 user_logouts 表中-- 不需要客户端输出，所以没有 RAISE NOTICE 或其他输出语句
CREATE FUNCTION on_logout_proc() RETURNS EVENT_TRIGGER AS $$
DECLARE
BEGIN
    INSERT INTO user_logouts (who)
    VALUES (SESSION_USER);
END;
$$ LANGUAGE plpgsql;

-- 创建登出事件触发器
CREATE EVENT TRIGGER on_logout_trigger ON LOGOUT EXECUTE PROCEDURE on_logout_proc();

-- 启用事件触发器
ALTER EVENT TRIGGER on_logout_trigger ENABLE ALWAYS;

